    "import.noDeviceInstalled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please install a device. Files and ROM of a Symbian device are needed for the installation.\n\nNote: Each app needs a suitable Symbian device to run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先安装设备。安装过程需要 Symbian 设备的文件和 ROM。\n\n注意：每个应用都需要合适的 Symbian 设备才能运行。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng cài một thiết bị. Cần các tệp và ROM của thiết bị Symbian để cài đặt.\n\nLưu ý: Mỗi ứng dụng cần một thiết bị Symbian phù hợp để chạy."
          }
        }
      }
    },
    "import.noFileSelected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to choose..."
          }
