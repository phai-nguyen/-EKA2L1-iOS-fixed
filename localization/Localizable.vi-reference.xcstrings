    "devices.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a device to switch to it. Swipe left to rename it or remove it along with its data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按设备即可切换。向左轻扫可重命名，或连同其数据一并删除。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào thiết bị để chuyển sang thiết bị đó. Vuốt sang trái để đổi tên hoặc xóa thiết bị cùng dữ liệu của nó."
          }
        }
      }
    },
    "devices.installed": {
