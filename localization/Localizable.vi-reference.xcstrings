    "settings.jit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT recompiler (dynarmic)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
