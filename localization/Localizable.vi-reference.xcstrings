    "settings.jit.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faster CPU emulation. Applies on the next app launch. Experimental: some apps may crash — turn it off if games misbehave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更快的 CPU 模拟，在下次启动应用时生效。实验性功能：部分应用可能崩溃——如果游戏异常请关闭它。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giả lập CPU nhanh hơn. Áp dụng từ lần mở ứng dụng tiếp theo. Tính năng thử nghiệm: một số ứng dụng có thể bị crash — hãy tắt nếu game hoạt động không ổn định."
          }
        }
      }
    },
    "settings.jit.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT permission is not active for this process. Enable JIT (debugger or a JIT enabler such as SideStore/StikDebug) and relaunch; otherwise the interpreter is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前进程未获得 JIT 权限。请启用 JIT（使用调试器，或 SideStore/StikDebug 等 JIT 启用工具）后重新启动应用；否则将使用解释器。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền JIT chưa hoạt động cho tiến trình này. Hãy bật JIT (bằng trình gỡ lỗi hoặc công cụ bật JIT như SideStore/StikDebug) rồi mở lại ứng dụng; nếu không, trình thông dịch sẽ được sử dụng."
          }
        }
      }
    },
