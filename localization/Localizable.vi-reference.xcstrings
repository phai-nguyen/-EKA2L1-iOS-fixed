    "controllerPointer.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointer controls require an external display and Full Screen. Hold Touch while moving to drag. Hidden pointers restore game key bindings. Motion and vibration use the controller when supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针控制需要外接显示器并开启全屏。移动时按住“触摸”即可拖动。隐藏指针后会恢复游戏按键映射。体感与震动在手柄支持时使用手柄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển con trỏ cần màn hình ngoài và chế độ Toàn màn hình. Giữ Chạm trong khi di chuyển để kéo. Khi ẩn con trỏ, các phím game sẽ được khôi phục. Chuyển động và rung sử dụng tay cầm khi được hỗ trợ."
          }
        }
      }
    },
