    "onboarding.device.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start by importing a ROM dump from a device you own. Some newer S60 devices also need the matching RPKG file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从你拥有的设备导入 ROM 转储开始。部分较新的 S60 设备还需要配套的 RPKG 文件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bằng cách nhập bản dump ROM từ thiết bị bạn sở hữu. Một số thiết bị S60 đời mới còn cần tệp RPKG tương ứng."
          }
        }
      }
    },
