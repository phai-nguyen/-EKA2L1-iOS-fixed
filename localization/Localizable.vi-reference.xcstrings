    "settings.hosts.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirect guest hostnames or wildcard suffixes to an IP address or another hostname, optionally with a port. Changes affect new connections; restart the game if it has cached an address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将客户机主机名或通配后缀重定向到 IP 地址或另一个主机名，并可指定端口。更改对新连接生效；如果游戏已缓存地址，请重新启动。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển hướng tên máy chủ của máy khách hoặc hậu tố ký tự đại diện đến địa chỉ IP hay tên máy chủ khác, có thể kèm cổng. Thay đổi áp dụng cho kết nối mới; hãy khởi động lại game nếu game đã lưu địa chỉ vào bộ nhớ đệm."
          }
        }
      }
    },
    "settings.hosts.hostname": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostname or *.suffix"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机名或 *.后缀"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên máy chủ hoặc *.hậu_tố"
          }
        }
      }
    },
    "settings.hosts.invalidAddress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid IP address or hostname with an optional port."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 IP 地址或主机名，并可指定端口。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập địa chỉ IP hoặc tên máy chủ hợp lệ, có thể kèm cổng."
          }
        }
      }
    },
    "settings.hosts.invalidHostname": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a hostname or *.suffix using letters, numbers, hyphens, underscores and dots."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入主机名或 *.后缀，可使用字母、数字、连字符、下划线和点。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
