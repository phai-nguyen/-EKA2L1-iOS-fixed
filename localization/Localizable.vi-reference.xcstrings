    "settings.netplay.directIpHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peers reach this device at its IP address and the discovery port above, so enter that pair on their side."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他玩家通过本机的 IP 地址和上面的发现端口连接，请把这两项告诉他们。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy ngang hàng truy cập thiết bị này bằng địa chỉ IP và cổng khám phá ở trên, vì vậy hãy nhập cặp thông tin đó ở phía họ."
          }
        }
      }
