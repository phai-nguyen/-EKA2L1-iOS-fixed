        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EKA2L1 不含固件、ROM 或游戏。请只使用你自己拥有并亲自转储的内容。"
          }
        },
        "vi": {
          "stringUnit": {
