    "import.error.alreadyExists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device to install already exists!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要安装的设备已存在！"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị cần cài đã tồn tại!"
          }
        }
      }
    },
    "import.error.archiveCorrupt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive could not be read. It may be incomplete, or use a compression method this build does not support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该压缩包。它可能不完整，或使用了此版本不支持的压缩方式。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc tệp nén. Tệp có thể chưa đầy đủ hoặc dùng phương thức nén mà bản dựng này không hỗ trợ."
          }
        }
      }
    },
    "import.error.archiveNoDevice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive holds no device: it needs either a ROM image (with its RPKG, if the ROM needs one) or an unpacked drive Z tree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包里没有设备：它需要包含 ROM 镜像（如果该 ROM 需要，还要有对应的 RPKG），或者已解包的 Z 盘目录树。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp nén không chứa thiết bị: cần có ảnh ROM (kèm RPKG nếu ROM yêu cầu) hoặc cây thư mục ổ Z đã giải nén."
          }
        }
      }
    },
