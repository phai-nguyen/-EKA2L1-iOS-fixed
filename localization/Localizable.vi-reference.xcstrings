    "import.archiveFile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7z archive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7z 压缩包"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp nén 7z"
          }
        }
      }
    },
    "import.archiveHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a .7z holding a device. Both common packagings work: a ROM image with its RPKG, or a device someone already unpacked into the emulator's folder layout (data/roms and data/drives/z).\n\nAnything else in the archive is ignored, so a pack meant to be dropped into the EKA2L1 folder by hand installs as-is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个包含设备的 .7z 文件。两种常见打包方式都支持：ROM 镜像连同它的 RPKG，或别人已经按模拟器目录结构解包好的设备（data/roms 与 data/drives/z）。\n\n压缩包里的其他内容会被忽略，因此原本打算手动放进 EKA2L1 文件夹的包可以直接安装。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tệp .7z chứa một thiết bị. Hỗ trợ cả hai kiểu đóng gói phổ biến: ảnh ROM kèm RPKG, hoặc thiết bị đã được giải nén sẵn theo cấu trúc thư mục của trình giả lập (data/roms và data/drives/z).\n\nMọi nội dung khác trong tệp nén sẽ bị bỏ qua, vì vậy gói vốn được thiết kế để chép thủ công vào thư mục EKA2L1 vẫn có thể cài nguyên trạng."
          }
        }
      }
    },
    "import.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装已取消。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy cài đặt."
          }
        }
      }
    },
    "import.cancelling": {
