    "import.recommendedDevices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended devices to install:\n\nS60v1: N-Gage\nS60v2: Nokia N70\nS60v3: Nokia 5320 XpressMusic, Nokia E5\nS60v5: Nokia 5800 XpressMusic, Nokia 5230\n\nFor S60v2 devices or higher, you may need to provide an additional file called RPKG.\n\nFor more info about device install, please check out our wiki: [eka2l1.miraheze.org](https://eka2l1.miraheze.org/wiki/Main_Page)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐安装的设备：\n\nS60v1：N-Gage\nS60v2：Nokia N70\nS60v3：Nokia 5320 XpressMusic、Nokia E5\nS60v5：Nokia 5800 XpressMusic、Nokia 5230\n\nS60v2 及更高版本的设备可能还需要提供一个名为 RPKG 的额外文件。\n\n关于设备安装的更多信息，请查看我们的 wiki：[eka2l1.miraheze.org](https://eka2l1.miraheze.org/wiki/Main_Page)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị khuyến nghị:\n\nS60v1: N-Gage\nS60v2: Nokia N70\nS60v3: Nokia 5320 XpressMusic, Nokia E5\nS60v5: Nokia 5800 XpressMusic, Nokia 5230\n\nVới thiết bị S60v2 trở lên, bạn có thể cần cung cấp thêm tệp RPKG.\n\nĐể biết thêm về cách cài thiết bị, hãy xem wiki: [eka2l1.miraheze.org](https://eka2l1.miraheze.org/wiki/Main_Page)"
          }
        }
      }
    },
