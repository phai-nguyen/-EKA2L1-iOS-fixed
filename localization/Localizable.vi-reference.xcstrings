    "home.error.deviceBootCrashed %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ took the app down while it was starting up, so it was skipped this time. Its ROM (or RPKG) dump is likely damaged — delete the device and install it again from a good dump."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在启动过程中导致应用崩溃，因此本次已跳过。它的 ROM（或 RPKG）转储很可能已损坏——请删除该设备，再用完好的转储重新安装。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ làm ứng dụng bị thoát khi đang khởi động nên lần này thiết bị đã bị bỏ qua. Bản dump ROM (hoặc RPKG) có thể bị hỏng — hãy xóa thiết bị rồi cài lại từ một bản dump tốt."
          }
        }
      }
    },
