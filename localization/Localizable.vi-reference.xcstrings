    "settings.netplay.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emulates Symbian Bluetooth multiplayer over the network. Changes apply from the next app launch. iOS will ask for Local Network permission on first use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过网络模拟 Symbian 蓝牙多人游戏。更改将在下次启动应用时生效。首次使用时 iOS 会请求本地网络权限。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giả lập chơi nhiều người qua Bluetooth của Symbian thông qua mạng. Thay đổi áp dụng từ lần mở ứng dụng tiếp theo. iOS sẽ yêu cầu quyền Mạng cục bộ trong lần sử dụng đầu tiên."
          }
        }
      }
    },
