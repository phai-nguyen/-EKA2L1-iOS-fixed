    "onboarding.install.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a device is installed, use the + button to add SIS, SISX, or supported N-Gage content to the current device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装设备后，用 + 按钮把 SIS、SISX 或受支持的 N-Gage 内容添加到当前设备。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi cài thiết bị, dùng nút + để thêm SIS, SISX hoặc nội dung N-Gage được hỗ trợ vào thiết bị hiện tại."
          }
        }
      }
    },
