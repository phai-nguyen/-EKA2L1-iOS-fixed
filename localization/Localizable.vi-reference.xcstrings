    "devices.renameFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not rename the device. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重命名该设备，请重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đổi tên thiết bị. Vui lòng thử lại."
          }
        }
      }
    },
    "devices.rescanHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescanning rebuilds the list from the device files already on disk — use it if an installed device went missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新扫描会根据磁盘上已有的设备文件重建列表——如果已安装的设备不见了，可以用它找回。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét lại sẽ dựng lại danh sách từ các tệp thiết bị đã có trên bộ nhớ — dùng khi một thiết bị đã cài bị mất khỏi danh sách."
          }
