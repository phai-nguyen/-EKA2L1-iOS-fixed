+        bws->uid_ = epoc::BITWISE_BITMAP_UID;
+
+        LOG_INFO(SERVICE_FBS, "Phone Mode V7 FBS: rasterized NVG bitmap {}x{} bpp {}", width, height, bpp);
+        return true;
+    }
