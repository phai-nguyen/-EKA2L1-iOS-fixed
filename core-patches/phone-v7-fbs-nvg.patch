+
+    static inline bool is_nvg_bitmap_rasterizable(const eka2l1::vec2 &size, const display_mode dpm) {
+        if ((size.x <= 0) || (size.y <= 0)) {
+            return false;
+        }
+
+        const int bpp = get_bpp_from_display_mode(dpm);
