+
+    bool flexible_mem_model_chunk::runtime_mapping_matches(const vm_address addr, const void *host) {
+        if (!is_addr_shared_ || !fixed_mapping_ || !mem_obj_ || !host) {
+            return !is_addr_shared_;
+        }
+        if (addr < fixed_mapping_->base_ || addr >= fixed_mapping_->base_ + max_size_) {
+            return false;
+        }
+        const void *expected = reinterpret_cast<std::uint8_t *>(mem_obj_->ptr()) + (addr - fixed_mapping_->base_);
+        return host == expected;
+    }
 }
