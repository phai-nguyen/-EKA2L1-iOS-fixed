+
+        memory_system *mem = kern->get_memory_system();
+        void *mapped_before = mem->get_real_pointer(run_addr);
+        const bool watched = (run_addr == 0x78C00000) || (run_addr == 0x7A700000) ||
+            (run_addr == 0x7B500000) || (run_addr == 0x7CC00000);
