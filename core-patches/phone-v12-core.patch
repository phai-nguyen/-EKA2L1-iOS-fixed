+            if (watched) {
+                LOG_INFO(KERNEL,
+                    "Phone Mode V12 RAMLIFE: watched mapping alive for {} process={} base=0x{:08X} size=0x{:X} page-host={} chunk-host={} phase={}",
+                    name(), pr ? pr->name() : "<shared>", run_addr, target->max_size(), mapped_before,
+                    target->host_base(), phase);
+            }
+            return true;
+        }
+
+        LOG_WARN(KERNEL,
+            "Phone Mode V12 RAMLIFE: missing mapping for {} process={} base=0x{:08X} size=0x{:X} page-host={} chunk-host={} phase={}; refreshing now",
+            name(), pr ? pr->name() : "<shared>", run_addr, target->max_size(), mapped_before,
+            target->host_base(), phase);
+
+        const bool refreshed = target->refresh_mapping();
+        void *mapped_after = mem->get_real_pointer(run_addr);
+
+        if (!refreshed || !mapped_after) {
+            LOG_ERROR(KERNEL,
+                "Phone Mode V12 RAMLIFE: LATE REPAIR FAILED for {} process={} base=0x{:08X} size=0x{:X} page-host={} chunk-host={} phase={}",
+                name(), pr ? pr->name() : "<shared>", run_addr, target->max_size(), mapped_after,
+                target->host_base(), phase);
+            return false;
+        }
+
+        LOG_INFO(KERNEL,
+            "Phone Mode V12 RAMLIFE: LATE REPAIR SUCCEEDED for {} process={} base=0x{:08X} size=0x{:X} page-host={} chunk-host={} phase={}",
+            name(), pr ? pr->name() : "<shared>", run_addr, target->max_size(), mapped_after,
+            target->host_base(), phase);
+        return true;
+    }
 
